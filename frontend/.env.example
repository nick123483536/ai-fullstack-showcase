# Where the dev server proxies /api requests (the Spring Boot backend).
VITE_PROXY_TARGET=http://localhost:8081

# Absolute API origin for production builds served separately from the backend.
# Leave empty to call /api on the same origin.
VITE_API_BASE_URL=

# Set to "true" to run the UI against built-in sample data instead of the backend.
VITE_USE_MOCK=false
