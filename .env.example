# Copy this file to .env and fill in your own values. Never commit .env.

# Password for the PostgreSQL container (also used by the backend)
POSTGRES_PASSWORD=postgres

# Secret used to sign JWTs: a long random string, at least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Free Adzuna API credentials from https://developer.adzuna.com
# Leave empty to switch the Adzuna source off
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
